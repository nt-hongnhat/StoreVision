<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.flowable.org/processdef">

    <!-- ID QUY TRÌNH KÍCH HOẠT TỪ SPRING BOOT -->
    <process id="orderProcessingSystem" name="Order Processing System" isExecutable="true">

        <!-- 1. START EVENT -->
        <startEvent id="StartEvent_Order" name="Bắt đầu đặt hàng"/>
        <sequenceFlow id="flow1" sourceRef="StartEvent_Order" targetRef="taskCheckStock"/>

        <!-- 2. SERVICE TASK: KIỂM TRA TỒN KHO -->
        <serviceTask id="taskCheckStock" name="Kiểm tra tồn kho"
                     flowable:delegateExpression="${checkStockDelegate}"/>
        <sequenceFlow id="flow2" sourceRef="taskCheckStock" targetRef="gatewayStock"/>

        <!-- 3. EXCLUSIVE GATEWAY: PHÂN NHÁNH TỒN KHO -->
        <exclusiveGateway id="gatewayStock" name="IsStockAvailable?"/>

        <!-- Nhánh còn hàng -> Chuyển sang Đóng gói hàng -->
        <sequenceFlow id="flowInStock" name="inStock == true" sourceRef="gatewayStock" targetRef="taskPackOrder">
            <conditionExpression xsi:type="tFormalExpression">${inStock == true}</conditionExpression>
        </sequenceFlow>

        <!-- Nhánh hết hàng -> Gửi email báo hết hàng -->
        <sequenceFlow id="flowOutOfStock" name="inStock == false" sourceRef="gatewayStock"
                      targetRef="taskSendOutOfStockEmail">
            <conditionExpression xsi:type="tFormalExpression">${inStock == false}</conditionExpression>
        </sequenceFlow>

        <!-- 4. SERVICE TASK: GỬI EMAIL HẾT HÀNG -->
        <serviceTask id="taskSendOutOfStockEmail" name="Gửi email thông báo hết hàng"
                     flowable:delegateExpression="${sendOutOfStockEmailDelegate}"/>
        <sequenceFlow id="flow3" sourceRef="taskSendOutOfStockEmail" targetRef="EndEvent_Cancelled"/>
        <endEvent id="EndEvent_Cancelled" name="Hủy đơn do hết hàng"/>

        <!-- 5. USER TASK: ĐÓNG GÓI HÀNG (WAREHOUSE) -->
        <userTask id="taskPackOrder" name="Đóng gói hàng" flowable:assignee="warehouse_staff"/>
        <sequenceFlow id="flow6" sourceRef="taskPackOrder" targetRef="taskPayment"/>

        <!-- 6. SERVICE TASK: XỬ LÝ THANH TOÁN -->
        <serviceTask id="taskPayment" name="Xử lý thanh toán"
                     flowable:delegateExpression="${paymentDelegate}"/>
        <sequenceFlow id="flow4" sourceRef="taskPayment" targetRef="taskSendSuccessEmail"/>

        <!-- 6a. BOUNDARY ERROR EVENT: BẮT LỖI THANH TOÁN THẤT BẠI -->
        <boundaryEvent id="errorPaymentFailed" name="Lỗi thanh toán" attachedToRef="taskPayment">
            <errorEventDefinition errorRef="PAYMENT_FAILED_ERROR"/>
        </boundaryEvent>
        <sequenceFlow id="flowPaymentError" sourceRef="errorPaymentFailed" targetRef="taskSendPaymentFailedEmail"/>

        <!-- 6b. SERVICE TASK: GỬI EMAIL THẤT BẠI THANH TOÁN -->
        <serviceTask id="taskSendPaymentFailedEmail" name="Gửi email thanh toán thất bại"
                     flowable:delegateExpression="${sendPaymentFailedEmailDelegate}"/>
        <sequenceFlow id="flowEndFailed" sourceRef="taskSendPaymentFailedEmail" targetRef="EndEvent_PaymentFailed"/>
        <endEvent id="EndEvent_PaymentFailed" name="Hủy đơn do lỗi thanh toán"/>

        <!-- 7. SERVICE TASK: GỬI EMAIL THÀNH CÔNG -->
        <serviceTask id="taskSendSuccessEmail" name="Gửi email thành công"
                     flowable:delegateExpression="${sendSuccessEmailDelegate}"/>
        <sequenceFlow id="flow5" sourceRef="taskSendSuccessEmail" targetRef="EndEvent_Success"/>
        <endEvent id="EndEvent_Success" name="Đơn hàng thành công"/>

    </process>

    <!-- ================================================================= -->
    <!-- TỌA ĐỘ ĐỒ HỌA DÙNG CHO PLUGIN INTELLIJ IDEA / CAMUNDA MODELER     -->
    <!-- ================================================================= -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_orderProcessingSystem">
        <bpmndi:BPMNPlane bpmnElement="orderProcessingSystem" id="BPMNPlane_orderProcessingSystem">

            <!-- SHAPES -->
            <bpmndi:BPMNShape bpmnElement="StartEvent_Order" id="BPMNShape_StartEvent_Order">
                <omgdc:Bounds height="30.0" width="30.0" x="100.0" y="163.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskCheckStock" id="BPMNShape_taskCheckStock">
                <omgdc:Bounds height="80.0" width="100.0" x="180.0" y="138.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="gatewayStock" id="BPMNShape_gatewayStock">
                <omgdc:Bounds height="40.0" width="40.0" x="330.0" y="158.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskSendOutOfStockEmail" id="BPMNShape_taskSendOutOfStockEmail">
                <omgdc:Bounds height="80.0" width="100.0" x="430.0" y="240.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="EndEvent_Cancelled" id="BPMNShape_EndEvent_Cancelled">
                <omgdc:Bounds height="28.0" width="28.0" x="580.0" y="266.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskPackOrder" id="BPMNShape_taskPackOrder">
                <omgdc:Bounds height="80.0" width="100.0" x="430.0" y="80.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskPayment" id="BPMNShape_taskPayment">
                <omgdc:Bounds height="80.0" width="100.0" x="580.0" y="80.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="errorPaymentFailed" id="BPMNShape_errorPaymentFailed">
                <omgdc:Bounds height="30.0" width="30.0" x="635.0" y="145.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskSendPaymentFailedEmail" id="BPMNShape_taskSendPaymentFailedEmail">
                <omgdc:Bounds height="80.0" width="100.0" x="720.0" y="200.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="EndEvent_PaymentFailed" id="BPMNShape_EndEvent_PaymentFailed">
                <omgdc:Bounds height="28.0" width="28.0" x="870.0" y="226.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="taskSendSuccessEmail" id="BPMNShape_taskSendSuccessEmail">
                <omgdc:Bounds height="80.0" width="100.0" x="730.0" y="80.0"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape bpmnElement="EndEvent_Success" id="BPMNShape_EndEvent_Success">
                <omgdc:Bounds height="28.0" width="28.0" x="880.0" y="106.0"/>
            </bpmndi:BPMNShape>

            <!-- EDGES -->
            <bpmndi:BPMNEdge bpmnElement="flow1" id="BPMNEdge_flow1">
                <omgdi:waypoint x="130.0" y="178.0"/>
                <omgdi:waypoint x="180.0" y="178.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow2" id="BPMNEdge_flow2">
                <omgdi:waypoint x="280.0" y="178.0"/>
                <omgdi:waypoint x="330.0" y="178.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowInStock" id="BPMNEdge_flowInStock">
                <omgdi:waypoint x="350.0" y="158.0"/>
                <omgdi:waypoint x="350.0" y="120.0"/>
                <omgdi:waypoint x="430.0" y="120.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowOutOfStock" id="BPMNEdge_flowOutOfStock">
                <omgdi:waypoint x="350.0" y="198.0"/>
                <omgdi:waypoint x="350.0" y="280.0"/>
                <omgdi:waypoint x="430.0" y="280.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow3" id="BPMNEdge_flow3">
                <omgdi:waypoint x="530.0" y="280.0"/>
                <omgdi:waypoint x="580.0" y="280.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow6" id="BPMNEdge_flow6">
                <omgdi:waypoint x="530.0" y="120.0"/>
                <omgdi:waypoint x="580.0" y="120.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow4" id="BPMNEdge_flow4">
                <omgdi:waypoint x="680.0" y="120.0"/>
                <omgdi:waypoint x="730.0" y="120.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowPaymentError" id="BPMNEdge_flowPaymentError">
                <omgdi:waypoint x="650.0" y="175.0"/>
                <omgdi:waypoint x="650.0" y="240.0"/>
                <omgdi:waypoint x="720.0" y="240.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowEndFailed" id="BPMNEdge_flowEndFailed">
                <omgdi:waypoint x="820.0" y="240.0"/>
                <omgdi:waypoint x="870.0" y="240.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flow5" id="BPMNEdge_flow5">
                <omgdi:waypoint x="830.0" y="120.0"/>
                <omgdi:waypoint x="880.0" y="120.0"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>